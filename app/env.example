# ---------------------------------------------------------------
# FrankPHP — Environment Configuration
# ---------------------------------------------------------------
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# .env.example SHOULD be committed — it documents every key
# the application needs without exposing real credentials.
# ---------------------------------------------------------------


# ---------------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------------
APP_NAME="Your App Name"
APP_TIMEZONE=UTC

# ---------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_db_username
DB_PASS=your_db_password

# ---------------------------------------------------------------
# EMAIL (SMTP via PHPMailer)
# ---------------------------------------------------------------
MAIL_HOST=smtp.yourmailprovider.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM_ADDRESS=you@yourdomain.com
MAIL_FROM_NAME="Your Name or App Name"
MAIL_REPLY_TO=you@yourdomain.com


# ---------------------------------------------------------------
# EMAIL (Recipient of Platform Level Alert Messages)
# ---------------------------------------------------------------
MAIL_SITE_ADMIN=admin@yourdomain.com

# ---------------------------------------------------------------
# CRON
# ---------------------------------------------------------------
CRON_SECRET=replace_with_a_long_random_secret

# ---------------------------------------------------------------
# FRONTEND LICENCE KEYS
# Keys here are intentionally exposed to the browser at render
# time via a server-injected JS config block. Moving them here
# removes them from source control — the real security win.
# They are still visible to authenticated users in page source.
# ---------------------------------------------------------------
SYNCFUSION_LICENSE_KEY=your_syncfusion_key_here
